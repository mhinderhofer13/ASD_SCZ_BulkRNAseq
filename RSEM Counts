module load uri/main all/STAR/2.7.10b-GCC-11.3.0 RSEM/1.3.3-foss-2022a

rsem-prepare-reference \
  --gtf /project/pi_cpak_umass_edu/Jay_Bulk_RNAseq/Genome_Ref/Homo_sapiens.GRCh38.115.gtf \
--star \
/project/pi_cpak_umass_edu/Jay_Bulk_RNAseq/Genome_Ref/Homo_sapiens.GRCh38.dna.primary_assembly.fa \
  /project/pi_cpak_umass_edu/Jay_Bulk_RNAseq/rsem_reference/human

#!/bin/bash
#SBATCH --job-name=RSEM_Counts
#SBATCH -c 18
#SBATCH --mem=96G
#SBATCH --time=24:00:00 
#SBATCH --constraint=avx512
#SBATCH --array=1-18
#SBATCH --output=RSEM_Counts_%A_%a.out
#SBATCH --error=RSEM_Counts_%A_%a.err

module load uri/main
module load all/RSEM/1.3.3-foss-2022a

PROJECT="/project/pi_cpak_umass_edu/Jay_Bulk_RNAseq"
ALIGN_DIR="${PROJECT}/STAR/STAR_alignv1/human"
RSEM_REF="${PROJECT}/RSEM/rsem_reference/human_GRCh38_GTF115"
OUT_DIR="${PROJECT}/RSEM/RSEM_counts"

i=${SLURM_ARRAY_TASK_ID}
num=$(printf "%02d" $i)
sample="25298R-01-${num}v1"
s_num=$((90 + i))
base="${sample}_S${s_num}_L003"

BAM="${ALIGN_DIR}/${sample}/${base}_human_Aligned.toTranscriptome.out.bam"

echo "[$(date)] Processing sample: ${sample}"
echo "Looking for BAM: ${BAM}"

if [[ ! -f "${BAM}" ]]; then
    echo "ERROR: Transcriptome BAM not found for ${sample} at ${BAM}. Skipping."
    exit 1
fi

SAMPLE_OUT="${OUT_DIR}/${sample}"

rsem-calculate-expression \
    --bam \
    --paired-end \
    --estimate-rspd \
    --append-names \
    --output-genome-bam \
    -p ${SLURM_CPUS_PER_TASK} \
    "${BAM}" \
    "${RSEM_REF}" \
    "${SAMPLE_OUT}"

echo "[$(date)] Finished RSEM for ${sample}"
